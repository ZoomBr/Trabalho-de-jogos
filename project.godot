; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Chaves do Reino"
config/description="Aventura top-down em 3 fases com chefão final. T2 - Introdução ao Desenvolvimento de Jogos (IFMG Ribeirão das Neves)."
run/main_scene="res://cenas/menus/menu_principal.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

Global="*res://scripts/autoload/global.gd"
Sons="*res://scripts/autoload/sons.gd"
Transicao="*res://cenas/autoload/transicao.tscn"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/custom="res://recursos/tema.tres"

