[node name="Texto" type="Label" parent="UI/ComoJogar/Caixa"]
layout_mode = 2
text = "Ache as 3 chaves, abra o portão e vença o chefão da fase.
Mover: WASD/setas   Atacar: Espaço/J/clique
Poder: Q/K/botão direito   Esquiva: Shift/L
Pausar: Esc/P.   Inimigos dão experiência: a cada
nível você escolhe uma melhoria.
Golem Escudeiro bloqueia golpes de frente: use a
esquiva para atacar pelas costas! Elites dourados
têm o dobro de vida e dão mais recompensa."
horizontal_alignment = 1

[node name="BotaoVoltar" type="Button" parent="UI/ComoJogar/Caixa"]
custom_minimum_size = Vector2(80, 14)
layout_mode = 2
size_flags_horizontal = 4
